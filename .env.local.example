JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Production: real backend URLs of each module (override src/config/modules.json)
# MODULE_STOCK_URL=https://k-erp-stock.onrender.com
# MODULE_ACCOUNTING_URL=https://k-erp-accounting.onrender.com

# Shows one-click demo login buttons on /erphub/login. Must be the password whose
# bcrypt hash is in src/config/users.example.json (see scripts/hash-password.mjs).
# NEXT_PUBLIC_DEMO_PASSWORD=Demo@2026
